# Khoá AI theo chuẩn OpenAI (VD: vyceai). Xem model có sẵn: GET <OPENAI_BASE_URL>/models
OPENAI_API_KEY=
OPENAI_BASE_URL=https://vyceai.com/v1
OPENAI_MODEL=agnes-3.0-flash,deepseek-v4-flash

# Mã để giáo viên đăng nhập (học sinh chỉ cần nhập tên)
TEACHER_CODE=giaovien

# Cổng chạy máy chủ
PORT=3000
